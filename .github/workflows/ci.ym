name: C++ CI

on:
  push:
  pull_request:

jobs:
  build-and-test:
    runs-on: ubuntu-latest

    steps:
    - uses: actions/checkout@v4

    - name: Install Dependencies
      run: sudo apt-get update
           sudo apt-get install -y make g++

    - name: Build
      run: make

    - name: Test
      run: make test-all